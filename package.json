{
  "name": "circuitarium-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Circuitarium MCP is a model-neutral server for circuit artifacts with CRUMBLE, an unofficial, version-pinned CRUMB .cru integration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craftiee/circuitarium-mcp.git"
  },
  "homepage": "https://github.com/Craftiee/circuitarium-mcp#readme",
  "bugs": {
    "url": "https://github.com/Craftiee/circuitarium-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "circuitarium",
    "electronics",
    "circuit-simulator",
    "crumb",
    "crumble",
    "breadboard",
    "circuit-analysis",
    "eda",
    "ai-tools"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run build && npm test && npm run fixtures:verify",
    "cli": "tsx src/cli.ts",
    "fixtures": "tsx src/cli.ts generate-all fixtures/crumb --force",
    "fixtures:verify": "tsx scripts/verify-fixtures.ts",
    "start:mcp": "tsx src/server.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "fast-xml-parser": "5.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
