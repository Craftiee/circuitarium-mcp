          "category": "functional",
          "priority": "must",
          "statement": "The block must produce the specified 32-bit arithmetic result for every accepted request.",
          "claimIds": [
            "functional-correctness"
          ]
        },
        {
          "id": "clock-target",
          "category": "timing",
          "priority": "must",
          "statement": "The implementation must meet the declared clock period in the selected signoff corner.",
          "claimIds": [
            "timing-closure"
          ]
        },
        {
          "id": "physical-cleanliness",
          "category": "physical",
          "priority": "must",
          "statement": "The final layout must satisfy the selected PDK's DRC deck and match the intended netlist under LVS.",
