          "direction": "input",
          "widthBits": 64,
          "clockDomain": "core-clock",
          "description": "Two packed 32-bit operands."
        },
        {
          "id": "response-data",
          "name": "response_data",
          "kind": "bus",
          "direction": "output",
          "widthBits": 32,
          "clockDomain": "core-clock",
